# Локально: DATABASE_URL="file:../data/dev.db"
# На Amvera: file:/data/dekanat.db (уже вписано в Dockerfile, вносить не нужно)
DATABASE_URL=
# Сколько дней живёт сессия (по умолчанию 14)
SESSION_DAYS=
# Суточный лимит запросов к ИИ на студента (по умолчанию 30)
AI_DAILY_LIMIT=
# Провайдер ИИ: пусто или stub = заглушка с готовыми ответами. Реальный провайдер выбирает автор проекта.
# Ключ провайдера, когда он появится, хранить только здесь и на сервере, без префикса NEXT_PUBLIC_.
AI_PROVIDER=
