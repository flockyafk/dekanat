# Локально: DATABASE_URL="file:../data/dev.db"
# На Amvera: file:/data/dekanat.db (уже вписано в Dockerfile, вносить не нужно)
DATABASE_URL=
# Сколько дней живёт сессия (по умолчанию 14)
SESSION_DAYS=
# Суточный лимит запросов к ИИ на студента (по умолчанию 30)
AI_DAILY_LIMIT=
# Провайдер ИИ: пусто или stub = заглушка с готовыми ответами; amvera = Amvera LLM (формат OpenAI).
AI_PROVIDER=
# Ключ Amvera LLM. Хранить ТОЛЬКО в .env (он в .gitignore) и в секретах проекта на Amvera.
# Без префикса NEXT_PUBLIC_, в git и в чат не отправлять.
AI_API_KEY=
# Имя модели в API Amvera (по умолчанию qwen3_30b), список: GET https://inference.waw0.amvera.ru/v1/models
AI_MODEL=
# Адрес API (по умолчанию https://inference.waw0.amvera.ru/v1)
AI_BASE_URL=
# Таймаут запроса к модели, миллисекунды (по умолчанию 30000)
AI_TIMEOUT_MS=
# Общий предел запросов к ИИ в сутки на всех студентов (по умолчанию 200): защищает месячный пакет токенов
AI_TOTAL_DAILY_LIMIT=
